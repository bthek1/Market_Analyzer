# =============================================================================
# Stock Market Analyser - single environment file
# =============================================================================
# ONE file at the repo root, read by every consumer:
#
#   backend    django-environ (core/settings/base.py)
#   frontend   Vite (envDir: '..') - ONLY the VITE_* keys are exposed to the browser
#   compose    docker-compose.yml ${VAR} interpolation (auto-loaded from here)
#   dev        scripts/dev.sh
#   prod       systemd EnvironmentFile, rendered from the Ansible vault
#
# Setup:  just env-init   (copies this file to .env)
#
# FORMAT RULES - systemd's EnvironmentFile is the strictest consumer, so keep it
# to flat KEY=value: no `export`, no ${OTHER} interpolation, no multi-line values,
# no command substitution. `#` comments and blank lines are fine.
#
# SECURITY - Vite only exposes VITE_-prefixed keys to the bundle, which is what
# makes it safe to keep SECRET_KEY and ANTHROPIC_API_KEY in the same file as the
# frontend config. Never set `envPrefix` in vite.config.ts.
#
# Every key below is optional unless marked REQUIRED; the value shown is the
# code default. Tuning knobs that are almost never changed (the OLLAMA_* agent
# caps, the KG_* knowledge-graph thresholds) are deliberately NOT listed here -
# see CLAUDE.md for the full set.

# -- Django -------------------------------------------------------------------
# REQUIRED. Any random string locally; on prod it comes from the Ansible vault.
SECRET_KEY=your-secret-key-here
DEBUG=True
# prod only (core.settings.prod reads these and has no default for ALLOWED_HOSTS)
# ALLOWED_HOSTS=192.168.2.200,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://192.168.2.200

# -- Database / Redis ---------------------------------------------------------
# Must agree with the POSTGRES_* / *_PORT values below, which drive docker-compose.
DATABASE_URL=postgresql://stockmarket:stockmarket@localhost:5435/stockmarket
CELERY_BROKER_URL=redis://localhost:6380/0

# -- Docker Compose (local containers only) -----------------------------------
POSTGRES_DB=stockmarket
POSTGRES_USER=stockmarket
POSTGRES_PASSWORD=stockmarket
# Host-side published ports. Non-default so they never collide with a system
# PostgreSQL/Redis on 5432/6379.
POSTGRES_PORT=5435
REDIS_PORT=6380

# -- Frontend (Vite) ----------------------------------------------------------
# ONLY VITE_-prefixed keys reach the browser bundle. Point this at wherever the
# Django dev server is reachable from your browser.
VITE_API_BASE_URL=http://localhost:8004

# -- LLM / Ollama -------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAIN_MODEL=qwen3:8b
OLLAMA_CLASSIFIER_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=60
# Mirror the Ollama server's own parallel slots so we never oversubscribe it.
OLLAMA_NUM_PARALLEL=4
# Declared explicitly so truncation is a choice, not an accident. Raising it evicts
# the classifier from VRAM on a 12 GB card - see core/settings/base.py for the numbers.
OLLAMA_NUM_CTX=4096
# Route selection: "llm" (classifier model) or "semantic" (embeddings, 0 LLM calls).
OLLAMA_ROUTE_MODE=llm

# -- Browser agent (/browse) --------------------------------------------------
# Seeds the LLMSettings singleton on first creation only.
# Off by default: it is the only agent that reaches the public internet, and it
# needs a Chrome/Chromium binary plus its apt shared libraries - run
# `just be-browser-setup` (NOT `playwright install --with-deps`, whose apt half is
# skipped silently without root).
BROWSER_ENABLED=False
# ollama (default, free) or anthropic (needs a real key above).
BROWSER_PROVIDER=ollama
# MUST be a vision model: browser-use sends a screenshot every step, and a text-only
# model 400s on every one of them. Blank = the provider's own default
# (OLLAMA_MAIN_MODEL, which is text-only). Pull it with: ollama pull qwen3-vl:8b
BROWSER_MODEL=qwen3-vl:8b
# Ollama's 4096 default is far too small for a browser-use step prompt (~15k tokens
# with a screenshot) and yields empty responses.
BROWSER_NUM_CTX=32768
BROWSER_MAX_STEPS=15
BROWSER_TIMEOUT_S=300
BROWSER_HEADLESS=True

# HuggingFace cache location. Set on prod (Ansible env.j2) to keep model weights
# on the app volume; unset locally means the library's own ~/.cache default.
# HF_HOME=/home/app/stock_market/models

# -- Logging / observability (issue #2) ---------------------------------------
# One JSON object per line on stdout -> systemd journal -> Alloy -> Loki.
# LOG_FORMAT=console swaps in a readable single line, which is usually what you
# want when developing locally.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Correlation id header. nginx generates one per request and forwards it here, so
# an access log line and its application log lines share an id.
REQUEST_ID_HEADER=X-Request-ID
# Expose django-prometheus metrics on :8005 in development. Off by default - binding a
# port on every `manage.py` invocation is a surprising side effect. Prod does not use
# this: it sets a port RANGE instead, one per gunicorn worker.
PROMETHEUS_METRICS_PORT_ENABLED=False

# -- Tracing (issue #5) -------------------------------------------------------
# OFF by default. When on, spans go to Grafana Alloy's OTLP receiver on the LOOPBACK,
# which batches and forwards them to Tempo - the app never learns where Tempo lives.
# Nothing is initialised until core.tracing.configure_tracing() is called from wsgi.py
# or celery.py, so a management command or a pytest run never exports anything.
OTEL_TRACES_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Head sampling on ROOT spans only; children follow their parent, so a trace is never
# half-recorded. 1.0 is affordable at this traffic level.
OTEL_TRACES_SAMPLER_RATIO=1.0

# -- Load testing (issue #12, `just lt*`) -------------------------------------
# Read by the k6 scripts (loadtest/k6/lib/config.js) and manage.py ensure_loadtest_user,
# not by Django settings. A dedicated NON-staff account; never a real user's.
LOADTEST_EMAIL=loadtest@stockmarket.local
LOADTEST_PASSWORD=change-me-loadtest
# Expected peak page views/s; load/stress/spike/soak are all shaped from it.
LOADTEST_RATE=5
# Targeting prod needs this set to 1 FOR THAT ONE RUN. Never leave it on in this file.
# LOADTEST_ALLOW_PROD=1

# -- Default superuser (manage.py create_default_users) -----------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
