SECRET_KEY={{ vault_secret_key }}
DEBUG=False
DATABASE_URL=postgresql://{{ db_user }}:{{ vault_db_password }}@{{ db_host }}:5432/{{ db_name }}
CELERY_BROKER_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
OLLAMA_BASE_URL={{ ollama_base_url }}
OLLAMA_MODEL={{ ollama_model }}
OLLAMA_MAIN_MODEL={{ ollama_main_model }}
OLLAMA_CLASSIFIER_MODEL={{ ollama_classifier_model }}
OLLAMA_EMBED_MODEL={{ ollama_embed_model }}
OLLAMA_TIMEOUT=60
HF_HOME={{ app_dir }}/models
LOG_LEVEL=INFO
LOG_FORMAT=json
# Tracing (issue #5). Safe in the SHARED env file, unlike PROMETHEUS_EXPORT_WORKER_PORTS
# which must stay in the gunicorn unit: that one binds ports from AppConfig.ready() in
# every process calling django.setup(), whereas tracing only starts where wsgi.py or
# celery.py explicitly call configure_tracing(). Management commands and the metrics
# exporter read this value and do nothing with it.
OTEL_TRACES_ENABLED={{ otel_traces_enabled | default(false) }}
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_TRACES_SAMPLER_RATIO={{ otel_traces_sampler_ratio | default(1.0) }}
DJANGO_SETTINGS_MODULE={{ django_settings_module }}
ALLOWED_HOSTS={{ container_ip }},stockmarket.local,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://{{ container_ip }},http://stockmarket.local
# Baked into the SPA bundle by `vite build` in deploy.sh (envDir = repo root).
# The browser talks to nginx on the app container, not to gunicorn directly.
VITE_API_BASE_URL=http://{{ container_ip }}
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD={{ vault_django_superuser_password }}
