[
  {
    "id": "deploy",
    "execute-command": "{{ app_dir }}/infra/deploy.sh",
    "command-working-directory": "{{ app_dir }}",
    "response-message": "Deploy triggered",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ vault_webhook_secret }}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
