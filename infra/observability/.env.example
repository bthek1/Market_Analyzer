# Grafana admin credentials. On prod, roles/monitoring templates this file from
# infra/ansible/vault/prod.yml (vault_grafana_admin_password). Locally: cp to .env.
# Compose requires the file to exist - without it Grafana would fall back to
# admin/admin silently.
GF_SECURITY_ADMIN_PASSWORD=change-me

# Alert email. Defaults in docker-compose.yml point at the LAN mail catcher on
# 192.168.2.207:1025; override here to send somewhere else.
GF_SMTP_HOST=192.168.2.207:1025
GF_SMTP_FROM_ADDRESS=grafana@stockmarket.lab
