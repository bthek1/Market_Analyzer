      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "gradientMode": "none",
            "lineInterpolation": "linear"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The WORST company per type, not the average - one ticker stuck days behind is the signal, and a mean over 500 would bury it. Financials are quarterly, so a ~90 day age there is normal.",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Un-bootstrapped stubs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "stockmarket_companies_unbootstrapped"
