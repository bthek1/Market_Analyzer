            "lineInterpolation": "linear"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "description": "bootstrap_tick drains this 5 at a time every 20 min. Rising means discovery is outrunning ingestion; flat and non-zero means the tick has stopped.",
      "id": 7
